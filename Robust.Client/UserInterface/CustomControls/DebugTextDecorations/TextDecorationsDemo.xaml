<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:cc="clr-namespace:Robust.Client.UserInterface.CustomControls;assembly=Robust.Client">
    <BoxContainer Orientation="Vertical" Separation="10" Margin="10">
        <!-- Labels for programmatic demonstration -->
        <Label Text="Label Examples (Programmatic):" FontColor="Yellow"/>
        <Label Name="LabelBold" Text="Bold Text Example"/>
        <Label Name="LabelItalic" Text="Italic Text Example"/>
        <Label Name="LabelOutline" Text="Outline Text Example"/>
        <Label Name="LabelShadow" Text="Shadow Text Example"/>
        <Label Name="LabelBoldItalicShadow" Text="Bold, Italic, Shadow Example"/>
        <Label Name="LabelOutlineShadow" Text="Outline and Shadow Example"/>

        <!-- RichTextLabels for markup demonstration -->
        <Label Text="RichTextLabel Examples (Markup):" FontColor="Yellow" Margin="0,10,0,0"/>
        <RichTextLabel Name="RichTextBold"/>
        <RichTextLabel Name="RichTextItalic"/>
        <RichTextLabel Name="RichTextOutline"/>
        <RichTextLabel Name="RichTextShadow"/>
        <RichTextLabel Name="RichTextCombined"/>
        <RichTextLabel Name="RichTextComplex"/>

        <!-- Example of setting via Style Properties (if they were defined in themes) -->
        <!-- For now, these will look like normal labels unless styles are actually added to a theme -->
        <Label Text="Label Examples (Style Properties - if styles are defined in theme):" FontColor="Yellow" Margin="0,10,0,0"/>
        <Label Text="Styled Bold Label" StyleClasses="LabelBoldStyled"/>
        <Label Text="Styled Italic Label" StyleClasses="LabelItalicStyled"/>
        <Label Text="Styled Outline Label" StyleClasses="LabelOutlineStyled"/>

    </BoxContainer>
</Control>
